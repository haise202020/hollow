# Required in production (min 32 chars). Generate with: openssl rand -hex 32
CSRF_SECRET=
AUTH_SECRET=

# Public site URL (used for webhook callbacks and absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Discord user id allowed to open /admin. Exposed to the browser so the header can show the admin link.
NEXT_PUBLIC_ADMIN_DISCORD_ID=

# SevenPay (server-only — never commit real values)
SEVENPAY_API_KEY=

# MongoDB (server-only)
# mongodb+srv works on Linux/macOS. On Windows, if SRV DNS fails, also set MONGODB_DIRECT_URI
# to a standard mongodb:// URI with the shard hosts.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/hollow?retryWrites=true&w=majority
MONGODB_DIRECT_URI=
MONGODB_DB=hollow

# Discord bot (server-only) — approve pending carts in the channel
DISCORD_BOT_TOKEN=
DISCORD_ORDERS_CHANNEL_ID=
# Opcional: IDs de roles (vírgula) que podem aprovar/recusar pedidos
DISCORD_STAFF_ROLE_IDS=
# Canal onde entram as entregas aprovadas (gamepass + nick)
DISCORD_DELIVERY_CHANNEL_ID=
# Canal de comprovantes / vouches
DISCORD_VOUCHES_CHANNEL_ID=

# Discord OAuth login (Discord Developer Portal → OAuth2)
# Redirect URL: http://localhost:3000/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
